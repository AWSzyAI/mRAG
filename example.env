# Copy to repo-root ``.env`` and fill values. Do not commit ``.env``.
# Scripts load this via ``src.mrag.envfile.load_dotenv`` (see ``test/pipeline_multi_dim_rag.py``, ``test/gemma4.py``).

# --- Dimension query generator: OpenAI-compatible API (when DIM_GENERATOR_TYPE=api or default) ---
DIM_GENERATOR_TYPE=api
DIM_GENERATOR_API_KEY=
DIM_GENERATOR_API_BASE=https://api.siliconflow.cn/v1
DIM_GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Hugging Face (gated models, snapshot_download for Gemma) ---
HF_TOKEN=
# Optional override if you want a different token only for Gemma load (else HF_TOKEN is used)
GEMMA4_HF_TOKEN=

# --- Gemma 4 E2B-it: local multimodal dimension generator (when DIM_GENERATOR_TYPE=gemma4_local) ---
# Directory containing config.json + weights (from ``python test/gemma4.py --mode download``).
GEMMA4_LOCAL_DIR=models/gemma4-e2b
GEMMA4_MODEL_ID=google/gemma-4-E2B-it
GEMMA4_DEVICE=cuda:1
# Max new tokens for the planner-only forward pass (not LLaVA)
GEMMA4_DIM_MAX_NEW_TOKENS=512

# --- Data / cache (optional; many scripts also accept CLI) ---
# CORPUS_DIR=/path/to/image_corpus
# MRAG-Bench Arrow cache + Hub metadata: prefer submodule cache or set explicitly.
# If unset, ``src.mrag.mrag_bench.ensure_mrag_hf_cache_env()`` auto-picks the first existing dir:
#   github/MRAG-Bench/.cache/huggingface-mrag  OR  models/huggingface-mrag
# MRAG_HF_HOME=github/MRAG-Bench/.cache/huggingface-mrag
# MRAG_HF_HOME=models/huggingface-mrag

# --- Offline GPU node (prepare on a networked machine e.g. infinity, then rsync) ---
# On GPU: forbid Hub access (fail fast if something still tries to download).
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# HF_DATASETS_OFFLINE=1
# If MRAG-Bench was downloaded on infinity, copy HF_HOME/HF_DATASETS_CACHE to GPU and point:
# HF_HOME=/path/to/synced_hf_home
# HF_DATASETS_CACHE=/path/to/synced_datasets_cache
# When JAX GPU hits CuDNN mismatch (runtime < compiled), run MagicLens on CPU JAX (slower):
# JAX_PLATFORMS=cpu

